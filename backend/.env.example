# All LLM settings below are optional. If LLM_API_KEY (or the legacy
# OPENAI_API_KEY) is unset, the app falls back to fully rule-based matching
# and template-based bullet drafting (zero external calls).

# Which provider to talk to. Every option here is an OpenAI-compatible Chat
# Completions API, so switching providers is just changing these values —
# no code or dependency changes needed. One of:
#   openai      https://api.openai.com/v1            (default)
#   deepseek    https://api.deepseek.com
#   groq        https://api.groq.com/openai/v1
#   openrouter  https://openrouter.ai/api/v1
#   together    https://api.together.xyz/v1
#   moonshot    https://api.moonshot.cn/v1
#   ollama      http://localhost:11434/v1              (local, no cloud key)
#   custom      any other OpenAI-compatible endpoint — set LLM_BASE_URL too
LLM_PROVIDER=openai

# API key for the provider above.
#   - openai:     https://platform.openai.com/api-keys
#   - deepseek:   https://platform.deepseek.com/api_keys
#   - groq:       https://console.groq.com/keys
#   - openrouter: https://openrouter.ai/keys
#   - together:   https://api.together.ai/settings/api-keys
#   - moonshot:   https://platform.moonshot.cn/console/api-keys
#   - ollama:     not required by Ollama itself, but the OpenAI SDK needs a
#                 non-empty string — any placeholder works, e.g. "ollama"
LLM_API_KEY=

# Model id for the chosen provider. Leave unset to use that provider's
# default (see PROVIDER_DEFAULTS in backend/app/config.py). Examples:
#   openai:     gpt-4o-mini, gpt-4o, o3-mini
#   deepseek:   deepseek-chat, deepseek-reasoner
#   groq:       llama-3.3-70b-versatile, mixtral-8x7b-32768
#   openrouter: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, ...
#   together:   meta-llama/Llama-3.3-70B-Instruct-Turbo
#   moonshot:   moonshot-v1-8k, moonshot-v1-32k
#   ollama:     llama3.1, qwen2.5, mistral, ... (whatever you've pulled)
LLM_MODEL=

# Override the provider's default API base URL. Required when
# LLM_PROVIDER=custom (e.g. Azure OpenAI, LM Studio, vLLM, a self-hosted
# gateway); optional otherwise.
LLM_BASE_URL=

# Legacy names, still read if the vars above are unset (LLM_PROVIDER is
# assumed "openai" in that case): OPENAI_API_KEY, OPENAI_MODEL.

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
